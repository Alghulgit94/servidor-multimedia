# =====================================================================
#  Configuración del servidor. Copiá este archivo como .env
#  (install.sh lo hace solo y detecta la IP).
# =====================================================================

# Carpeta base: acá se guardan configuraciones (AppData) y películas (data)
DATA_DIR=/DATA

# Usuario y grupo dueños de los archivos. Averigualo con el comando: id
PUID=1000
PGID=1000

# Zona horaria (lista: timedatectl list-timezones)
TZ=America/Asuncion

# IP del servidor en tu red. Vacío = se detecta sola
SERVER_IP=

# Nombre que muestran Jellyfin y las apps
SERVER_NAME=servidor-multimedia

# Audio en español latino: exigir (solo versiones latinas) | preferir
AUDIO_MODO=exigir

# Cuántos indexadores de torrents buscar y dejar funcionando
INDEXADORES=8
